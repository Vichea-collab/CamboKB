# Copy to .env.production (git-ignored) and fill in. Used by docker-compose.prod.yml.
PUBLIC_ORIGIN=https://shop.example.com
STORE_NAME=Cambo Supply

POSTGRES_USER=cambo
POSTGRES_PASSWORD=
# Password for the read-only reporting login (report/sql/readonly-role.sql)
REPORT_DB_PASSWORD=

# 32+ random characters each: openssl rand -base64 36
FILE_SERVICE_SECRET=
REPORT_SERVICE_SECRET=
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=

# local (Docker volume) or s3 (AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
