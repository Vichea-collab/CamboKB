# Copy to .env.production (git-ignored) and fill in. Used by docker-compose.prod.yml.
PUBLIC_ORIGIN=https://shop.example.com
STORE_NAME=Cambo Keyboard Supply

# Where CI publishes the images (<repo>-api, -file, -report, -notification, -web) and which version to run.
IMAGE_REPO=ghcr.io/vichea-collab/cambokb
IMAGE_TAG=latest

# One Postgres per service, one password each (openssl rand -base64 24)
POSTGRES_USER=cambo
POSTGRES_PASSWORD=
FILE_DB_PASSWORD=
REPORT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# Redis: the api's catalogue cache and shared rate limits. A cache only (nothing is saved); the shop works without it.
# REDIS_PASSWORD is required. Use letters and digits only, because it goes into a URL: openssl rand -hex 24
REDIS_PASSWORD=
# How much memory the cache may use before it evicts the oldest entries (a small server may want 32mb).
REDIS_MAXMEMORY=64mb

# Secrets the services use to call each other: 32+ random characters each (openssl rand -base64 36)
FILE_SERVICE_SECRET=
REPORT_SERVICE_SECRET=
NOTIFICATION_SERVICE_SECRET=
API_INTERNAL_SECRET=

# Telegram bot (the notification service owns it). Webhook URL is set automatically to PUBLIC_ORIGIN/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Required: Telegram sends it back on every webhook call and the bot refuses calls without it. Only A-Z a-z 0-9 _ - are
# allowed, so use hex: openssl rand -hex 32   (not -base64: it can contain + / =)
TELEGRAM_WEBHOOK_SECRET=
# Chat that gets new-order alerts: your own Telegram id (@userinfobot) or a group id
TELEGRAM_ADMIN_CHAT_ID=
# Required for "Continue with Telegram" inside the Telegram Mini App. NOT the bot token: a one-way value made from it, so
# the api can check Telegram's signatures but cannot control the bot. 64 hex characters. Make it with (token typed
# at the prompt, never in shell history or a file):
#   read -rs T; printf %s "$T" | openssl dgst -sha256 -hmac "WebAppData" -hex | awk '{print $NF}'; unset T
# Make it again whenever TELEGRAM_BOT_TOKEN changes (docs/deployment.md, "Telegram login").
TELEGRAM_WEBAPP_KEY=

# --- Cloudflare Tunnel (nothing on the machine is open to the internet) ---
# Made once with the cloudflared command line (see docs/deployment.md, "Cloudflare"):
#   cloudflared tunnel create cambokb
#   cloudflared tunnel route dns cambokb shop.example.com
# Then give the tunnel's id and the credentials file it wrote (a secret: keep it out of git), set WEB_BIND=127.0.0.1:80
# below, and start the stack with the tunnel profile: `export COMPOSE_PROFILES=tunnel` in your shell (Compose does
# not read it from this file).
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARED_CREDENTIALS_FILE=/Users/you/.cloudflared/<tunnel-id>.json
# Where the web container listens on the server. 0.0.0.0:80 for a normal setup, 127.0.0.1:80 with a Tunnel.
WEB_BIND=0.0.0.0:80

# Admin login lasts this many days from the moment of login (does not extend with use). Default 1.
ADMIN_SESSION_TTL_DAYS=1

# Grafana login (user: admin). Open it through an SSH tunnel: ssh -L 3001:127.0.0.1:3001 <server>
GRAFANA_ADMIN_PASSWORD=

# local (Docker volume) or s3 (Cloudflare R2, DigitalOcean Spaces, AWS S3)
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# Spaces: S3_ENDPOINT=https://sgp1.digitaloceanspaces.com, S3_REGION=sgp1
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# KHQR payments: your Bakong account ID (e.g. shop@aclb) and Open API token
# (https://api-bakong.nbc.gov.kh, renew every 90 days). Leave empty to keep KHQR off.
BAKONG_ACCOUNT_ID=
BAKONG_TOKEN=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
