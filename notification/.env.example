NODE_ENV=development
PORT=4300
# The notification service's own database (its message queue). createdb cambo_notifications
NOTIFICATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cambo_notifications"
# What the api must send when it calls this service. Same value as NOTIFICATION_SERVICE_SECRET in api/.env
# (32+ random characters in production).
NOTIFICATION_SERVICE_SECRET=dev-notification-secret-change-me-012345
# Where the api is, and what this service sends when it calls the api. Same value as API_INTERNAL_SECRET in api/.env
API_URL=http://localhost:4000
API_INTERNAL_SECRET=dev-api-internal-secret-change-me-0123456
# Used to link to the shop in messages
WEB_ORIGIN=http://localhost:5173

# --- Telegram bot (create one with @BotFather) ---
# off = log messages only, polling = local development, webhook = production
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back on every webhook call (webhook mode only)
TELEGRAM_WEBHOOK_SECRET=
# Public URL of POST /telegram/webhook, e.g. https://shop.example.com/telegram/webhook (webhook mode only)
TELEGRAM_WEBHOOK_URL=
# Chat that receives new-order alerts and the order buttons: your own Telegram user id or a group id
TELEGRAM_ADMIN_CHAT_ID=
