# Leave empty in development (Vite proxies /api to the api on :4000).
# In production set it to the api's public origin, e.g. https://api.cambosupply.com
VITE_API_URL=
# Your bot's username without @, shown on the sign-up screen
VITE_TELEGRAM_BOT_USERNAME=CamboSupplyBot

# Public address of the shop, used for link previews (https://shop.example.com). Needed at build time.
VITE_SITE_URL=http://localhost:5173
