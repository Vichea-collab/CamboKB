NODE_ENV=development
PORT=4100
# Shared with the api (FILE_SERVICE_SECRET there). At least 32 random characters in production.
FILE_SERVICE_SECRET=dev-file-secret-change-me-0123456789
# Web origins allowed to load files cross-origin
CORS_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
# S3 / Cloudflare R2 (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
