{
  "name": "cambo-supply",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "service-kit",
    "api",
    "file",
    "report",
    "notification",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/pipeline-notify.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:seed": "npm run db:seed --workspace @cambo/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "fsevents": false,
    "puppeteer@25.17.0": true
  },
  "overrides": {
    "bakong-khqr": {
      "axios": "1.21.1"
    }
  }
}
