# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cambo_supply"
# Tests use a separate database (created automatically if your user can create DBs)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/cambo_supply_test"
# Comma-separated list of allowed web origins (CORS + CSRF origin check)
WEB_ORIGIN=http://localhost:5173
# Set to your parent domain in production when web and API are on subdomains, e.g. .cambosupply.com
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# true when running behind a reverse proxy / load balancer (needed for correct client IPs)
TRUST_PROXY=false

# --- Telegram bot (create one with @BotFather) ---
# off = log messages only, polling = local development, webhook = production
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Public URL of POST /api/v1/telegram/webhook (webhook mode only)
TELEGRAM_WEBHOOK_URL=
# Chat that receives new-order alerts (your own Telegram user id or a group id)
TELEGRAM_ADMIN_CHAT_ID=

# --- Internal services ---
FILE_SERVICE_URL=http://localhost:4100
# Same value as FILE_SERVICE_SECRET in file/.env (32+ random characters in production)
FILE_SERVICE_SECRET=dev-file-secret-change-me-0123456789
# Public base URL for images (the file service's /files, or a CDN in front of it)
PUBLIC_FILES_URL=http://localhost:4100/files
REPORT_SERVICE_URL=http://localhost:4200
# Same value as REPORT_SERVICE_SECRET in report/.env
REPORT_SERVICE_SECRET=dev-report-secret-change-me-0123456789

# --- Rate limits ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Optional: serve the built web app from the API (single-server hosting)
SERVE_WEB_DIR=

# --- KHQR payments (Bakong, National Bank of Cambodia) ---
# Both of these must be set for KHQR to appear at checkout.
# Your Bakong account ID (the one your bank app shows, e.g. yourname@aclb or shop@abaa)
BAKONG_ACCOUNT_ID=
# Open API token from https://api-bakong.nbc.gov.kh (register with your email). Expires every 90 days.
BAKONG_TOKEN=
# Point this at a relay if the api runs outside Cambodia and Bakong refuses foreign IPs.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
# Shown in the customer's bank app when they scan (max 25 / 15 characters)
BAKONG_MERCHANT_NAME=Cambo Supply
BAKONG_MERCHANT_CITY=Phnom Penh
# Each QR lasts this long; unpaid orders are cancelled (stock released) after the hold time.
KHQR_QR_TTL_MINUTES=10
KHQR_ORDER_HOLD_MINUTES=10
