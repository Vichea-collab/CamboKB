{
  "name": "@cambo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:promote": "tsx --env-file-if-exists=.env scripts/promote-admin.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  }
}
