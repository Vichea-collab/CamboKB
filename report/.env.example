NODE_ENV=development
PORT=4200
# Use a login user that belongs to the read-only role created by report/sql/readonly-role.sql.
REPORT_DATABASE_URL="postgresql://cambo_report_login:change-me@localhost:5432/cambo_supply"
# Shared with the api (REPORT_SERVICE_SECRET there). At least 32 random characters in production.
REPORT_SERVICE_SECRET=dev-report-secret-change-me-0123456789
STORE_NAME=Cambo Supply

# Optional: path to Chrome/Chromium for PDF rendering (Docker sets /usr/bin/chromium-browser)
CHROME_PATH=
PDF_WORKERS=2
