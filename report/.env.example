NODE_ENV=development
PORT=4200
# The report service's own database (a copy of the order facts it needs, filled by events from the api). createdb cambo_reports
REPORT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cambo_reports"
# Shared with the api (REPORT_SERVICE_SECRET there). At least 32 random characters in production.
REPORT_SERVICE_SECRET=dev-report-secret-change-me-0123456789
STORE_NAME="Cambo Keyboard Supply"

# Optional: path to Chrome/Chromium for PDF rendering (Docker sets /usr/bin/chromium-browser)
CHROME_PATH=
PDF_WORKERS=2
