# A container that is restarted or updated may come back with another address. Left alone, nginx looks a name up once,
# when it starts, and keeps calling the old address; "resolve" makes it ask Docker's own DNS again and again.
resolver 127.0.0.11 valid=5s ipv6=off;
upstream api_service          { zone api_service 64k;          server api:4000 resolve; }
upstream file_service         { zone file_service 64k;         server file:4100 resolve; }
upstream notification_service { zone notification_service 64k; server notification:4300 resolve; }

# Link-preview bots and search crawlers don't run JavaScript. They get a plain
# HTML page with the product's title, photo and price (served by the api).
# People always get the app.
map $http_user_agent $is_crawler {
  default 0;
  ~*(TelegramBot|facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|Googlebot|bingbot|DuckDuckBot|Applebot) 1;
}

server {
  listen 80;
  server_name _;
  include /etc/nginx/conf.d/real-ip.inc;
  root /usr/share/nginx/html;

  # Admin uploads: up to 10 photos x 8 MB per request.
  client_max_body_size 90m;
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  location = /healthz {
    access_log off;
    return 200 'ok';
  }

  # Live admin updates (Server-Sent Events): one long-lived response per open admin tab.
  # Buffering would hold events back until a buffer fills, so it is off.
  location = /api/v1/admin/events {
    include /etc/nginx/conf.d/security-headers.inc;
    proxy_pass http://api_service;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Telegram delivers bot messages here (webhook mode). The notification service checks the secret header.
  location = /telegram/webhook {
    limit_except POST { deny all; }
    proxy_pass http://notification_service/webhook;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 30s;
  }

  # API (the only service the browser calls for data).
  location /api/ {
    include /etc/nginx/conf.d/security-headers.inc;
    proxy_pass http://api_service;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 60s;
  }

  # Search engines: sitemap and robots come from the api (they list the live catalogue).
  location ~ ^/(robots\.txt|sitemap\.xml)$ {
    include /etc/nginx/conf.d/security-headers.inc;
    proxy_pass http://api_service;
    proxy_set_header Host $host;
  }

  # Product and banner images, and 1200x630 link-preview images.
  location /files/ {
    include /etc/nginx/conf.d/security-headers.inc;
    proxy_pass http://file_service;
    proxy_set_header Host $host;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Hashed build assets never change.
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Product pages: crawlers get the plain page, people get the app.
  location ~ ^/products/([^/]+)$ {
    error_page 418 = @crawler;
    if ($is_crawler) {
      return 418;
    }
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache";
    try_files /index.html =404;
  }

  location @crawler {
    rewrite ^/products/(.*)$ /seo/products/$1 break;
    proxy_pass http://api_service;
    proxy_set_header Host $host;
  }

  # Single-page app: unknown paths load index.html (never cached).
  location / {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
