    {
      "id": 32,
      "type": "stat",
      "title": "Cache hit ratio (5 min)",
      "description": "Share of catalogue lookups the api answered from Redis. Errors (Redis down) are not counted as misses.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(cache_requests_total{result=~\"hit|miss\"}[5m])), 0.000001)",
          "legendFormat": "hit ratio",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
